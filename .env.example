# Base URL of the real backend. All services build their requests on top of it.
VITE_API_BASE_URL=/api

# "true" serves every request from the in-browser mock backend (MSW).
# Set to "false" once the real backend is reachable at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Mock backend only: artificial latency range in ms, and the share of requests (0-1) that fail on purpose.
VITE_MOCK_LATENCY_MIN=250
VITE_MOCK_LATENCY_MAX=700
VITE_MOCK_ERROR_RATE=0
